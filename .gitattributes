# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicitly declare text files
*.rs text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# Binary files
*.png binary
*.jpg binary
*.tar.gz binary
*.zip binary
*.dylib binary
*.so binary
*.dll binary
